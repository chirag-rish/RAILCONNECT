# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/rtms_db

# JWT Secret (change this in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Node Environment
NODE_ENV=development

# Server Port
PORT=5002

# Email Configuration (Optional - for booking confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# ============================================================
# Phase 5A — Real-Time Data Source Configuration
# ============================================================
# Data sources are tried in priority order:
#   1. RTIS (Indian Railways official — requires authorization)
#   2. NTES (National Train Enquiry — requires authorization)
#   3. Live Provider (legitimate third-party — requires API key)
#   4. Simulator (always available as fallback — no config needed)

# RTIS — Real Time Information System (official railway data)
# Only enable when authorized API access is granted by Indian Railways
# RTIS_ENABLED=false
# RTIS_API_ENDPOINT=
# RTIS_API_KEY=
# RTIS_ORG_ID=

# NTES — National Train Enquiry System (official railway data)
# Only enable when authorized API access is granted
# NTES_ENABLED=false
# NTES_API_ENDPOINT=
# NTES_API_KEY=

# Live Data Provider — RailRadar (legitimate third-party service)
# Requires a valid API key from https://railradar.in
# When enabled, the server polls train positions from RailRadar
# and feeds real telemetry into the prediction pipeline.
#
# IMPORTANT: Never expose LIVE_PROVIDER_API_KEY to frontend code.
# The key is only used server-side in the polling service.
#
# LIVE_PROVIDER_ENABLED=true
# LIVE_PROVIDER_NAME=RailRadar
# LIVE_PROVIDER_API_ENDPOINT=https://api.railradar.in/v1
# LIVE_PROVIDER_API_KEY=your-railradar-api-key-here
# LIVE_PROVIDER_POLL_INTERVAL=60000

# Simulation speed multiplier (default: 1 = real-time)
# SIMULATION_SPEED=1

